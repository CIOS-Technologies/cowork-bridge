{
  "display_information": {
    "name": "NAME Cowork Reader",
    "description": "Answers colleagues' questions from NAME's Cowork context, read-only. NAME approves every answer."
  },
  "features": {
    "bot_user": { "display_name": "SHORTNAME-cowork", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["groups:history", "groups:read", "chat:write", "im:history", "im:read", "im:write", "reactions:write", "users:read", "files:read"]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["message.groups", "message.im"] },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
